-- max-mcp launcher, generated by tools/install.py
-- Resolves from this startup file; moving the Max installation keeps it valid.
global __MAXMCP_LAUNCHED
if __MAXMCP_LAUNCHED != true do
(
    local sourcePath = getSourceFileName()
    local startupDir = getFilenamePath sourcePath
    local payload = pathConfig.appendPath startupDir "..\maxmcp\max_mcp_bridge.ms"
    if not (doesFileExist payload) do
        payload = pathConfig.appendPath (getDir #scripts) "maxmcp\max_mcp_bridge.ms"
    if doesFileExist payload then
    (
        try
        (
            fileIn payload
            __MAXMCP_LAUNCHED = true
        )
        catch (format "[max-mcp] launcher failed: %\n" (getCurrentException()))
    )
    else (format "[max-mcp] missing bridge: %\n" payload)
)
